# Google Gemini API Key Configuration
# Get your free key at: https://aistudio.google.com/app/apikey
#
# To configure Gemini access locally via environment file:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Replace the placeholder below with your Gemini API key:
#    GEMINI_API_KEY=your_gemini_api_key_here
#
# Note: .env is in .gitignore and will NEVER be committed to Git.

GEMINI_API_KEY=your_gemini_api_key_here
PORT=8080
